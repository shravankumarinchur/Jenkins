pipeline {
  agent any

  options {
    disableConcurrentBuilds()
  }

  triggers {
    pollSCM('H/5 * * * *')
  }

  stages {
    stage('Check trigger') {
      steps {
        script {
          def subject = sh(script: 'git log -1 --pretty=%s', returnStdout: true).trim()
          def manualBuild = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause').size() > 0
          env.SKIP_PIPELINE = (!manualBuild && subject.startsWith('ci: update deployment image to ')) ? 'true' : 'false'
          if (env.SKIP_PIPELINE == 'true') {
            echo 'Skipping the manifest-only commit made by this pipeline.'
          } else if (manualBuild) {
            echo 'Manual build requested; running all pipeline stages.'
          }
        }
      }
    }

    stage('Build and Test') {
      when {
        beforeAgent true
        expression { env.SKIP_PIPELINE != 'true' }
      }
      agent {
        docker {
          image 'ocir.us-ashburn-1.oci.oraclecloud.com/idsccoayafgg/my-project/maven-agent:v1'
          registryUrl 'https://ocir.us-ashburn-1.oci.oraclecloud.com/'
          registryCredentialsId 'OCIR'
          reuseNode true
          args '--user root'
        }
      }
      steps {
        sh 'java -version && javac -version && mvn -version && git --version'
        sh 'cd spring-boot-app && mvn -s ../ci/maven-settings.xml -B -ntp clean verify'
      }
    }

    stage('Static Code Analysis') {
      when {
        beforeAgent true
        expression { env.SKIP_PIPELINE != 'true' }
      }
      agent {
        docker {
          image 'ocir.us-ashburn-1.oci.oraclecloud.com/idsccoayafgg/my-project/maven-agent:v1'
          registryUrl 'https://ocir.us-ashburn-1.oci.oraclecloud.com/'
          registryCredentialsId 'OCIR'
          reuseNode true
          args '--user root --network host'
        }
      }
      environment {
        SONAR_URL = 'http://127.0.0.1:9000/'
      }
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_TOKEN')]) {
          sh 'cd spring-boot-app && mvn -s ../ci/maven-settings.xml -B -ntp org.sonarsource.scanner.maven:sonar-maven-plugin:5.0.0.4389:sonar -Dsonar.host.url="$SONAR_URL"'
        }
      }
    }

    stage('Build and Push Image') {
      when { expression { env.SKIP_PIPELINE != 'true' } }
      steps {
        withCredentials([usernamePassword(credentialsId: 'OCIR', usernameVariable: 'OCI_USER', passwordVariable: 'OCI_TOKEN')]) {
          sh '''
            set -eu
            docker version
            REGISTRY='ocir.us-ashburn-1.oci.oraclecloud.com'
            IMAGE_TAG="${REGISTRY}/idsccoayafgg/my-project/ultimate-cicd:${BUILD_NUMBER}"

            printf '%s' "$OCI_TOKEN" | docker login -u "$OCI_USER" --password-stdin "$REGISTRY"
            cd spring-boot-app
            docker build -t "$IMAGE_TAG" .
            docker push "$IMAGE_TAG"
          '''
        }
      }
    }

    stage('Update Deployment File') {
      when { expression { env.SKIP_PIPELINE != 'true' } }
      environment {
        GIT_REPO_NAME = 'Jenkins'
        GIT_REPO_OWNER = 'shravankumarinchur'
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'github', usernameVariable: 'GITHUB_AUTH_USER', passwordVariable: 'GITHUB_TOKEN')]) {
          sh '''
            set -eu
            IMAGE_TAG="ocir.us-ashburn-1.oci.oraclecloud.com/idsccoayafgg/my-project/ultimate-cicd:${BUILD_NUMBER}"
            MANIFEST='spring-boot-app-manifests/deployment.yml'

            if ! grep -Eq '^[[:space:]]*image:[[:space:]]*[^[:space:]]*/ultimate-cicd:[^[:space:]]+' "$MANIFEST"; then
              echo 'Expected ultimate-cicd image reference was not found in the Deployment.' >&2
              exit 1
            fi
            sed -i -E "s|^[[:space:]]*image:[[:space:]]*[^[:space:]]*/ultimate-cicd:[^[:space:]]+|        image: ${IMAGE_TAG}|" "$MANIFEST"

            git add "$MANIFEST"
            if git diff --cached --quiet; then
              echo "Deployment already uses ${IMAGE_TAG}; nothing to commit."
              exit 0
            fi

            git -c user.email='shravankumarinchur868@gmail.com' -c user.name='Shravan Inchur' commit -m "ci: update deployment image to ${BUILD_NUMBER}"
            GIT_ASKPASS="$PWD/ci/git-askpass.sh" GIT_TERMINAL_PROMPT=0 git -c credential.helper= -c http.proxy=http://www-proxy-wdc.oraclecorp.com:80 push "https://github.com/${GIT_REPO_OWNER}/${GIT_REPO_NAME}.git" HEAD:main
          '''
        }
      }
    }
  }
}
